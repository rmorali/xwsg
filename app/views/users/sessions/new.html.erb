<div class="auth-viewport">
  <div class="auth-terminal">
    <div class="auth-header">
      <%= image_tag('star wars.png', class: 'auth-logo') %>
      <div class="auth-subtitle">X-WING STRATEGY GAME</div>
      <div class="auth-title">ACESSO À PONTE DE COMANDO</div>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="auth-form-grid">
        <div class="auth-field">
          <label class="auth-label">CREDENCIAL // E-MAIL</label>
          <%= f.input :email, required: false, autofocus: true, label: false, placeholder: 'comandante@imperio.gal', input_html: { class: 'auth-input' } %>
        </div>

        <div class="auth-field">
          <label class="auth-label">CÓDIGO DE ACESSO // SENHA</label>
          <%= f.input :password, required: false, label: false, placeholder: '••••••••', input_html: { class: 'auth-input' } %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="auth-remember">
            <%= f.input :remember_me, as: :boolean, label: 'Manter terminal conectado' %>
          </div>
        <% end %>

        <div class="auth-actions">
          <%= f.button :submit, 'INICIAR SESSÃO', class: 'auth-btn-primary' %>
        </div>
      </div>
    <% end %>

    <div class="auth-footer-links">
      <%= render 'users/shared/links' %>
    </div>
  </div>
</div>