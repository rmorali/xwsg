<div class="auth-viewport">
  <div class="auth-terminal">
    <div class="auth-header">
      <%= image_tag('star wars.png', class: 'auth-logo') %>
      <div class="auth-subtitle">PROTOCOLO DE RECUPERAÇÃO</div>
      <div class="auth-title">REDEFINIR CÓDIGO DE ACESSO</div>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= f.error_notification class: 'auth-error-banner' %>

      <div class="auth-form-grid">
        <div class="auth-field">
          <label class="auth-label">E-MAIL CADASTRADO</label>
          <%= f.input :email, required: true, autofocus: true, label: false, placeholder: 'comandante@imperio.gal', input_html: { class: 'auth-input' } %>
        </div>

        <div class="auth-actions">
          <%= f.button :submit, 'ENVIAR INSTRUÇÕES DE RESET', class: 'auth-btn-primary' %>
        </div>
      </div>
    <% end %>

    <div class="auth-footer-links">
      <%= render 'users/shared/links' %>
    </div>
  </div>
</div>