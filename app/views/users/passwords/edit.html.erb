<div class="auth-viewport">
  <div class="auth-terminal">
    <div class="auth-header">
      <%= image_tag('star wars.png', class: 'auth-logo') %>
      <div class="auth-subtitle">PROTOCOLO DE SEGURANÇA</div>
      <div class="auth-title">CADASTRAR NOVA SENHA</div>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.error_notification class: 'auth-error-banner' %>
      <%= f.input :reset_password_token, as: :hidden %>
      <%= f.full_error :reset_password_token %>

      <div class="auth-form-grid">
        <div class="auth-field">
          <label class="auth-label">
            NOVA SENHA
            <% if @minimum_password_length %>
              <span class="auth-hint">(mín. <%= @minimum_password_length %> caracteres)</span>
            <% end %>
          </label>
          <%= f.input :password, required: true, autofocus: true, label: false, input_html: { class: 'auth-input' } %>
        </div>

        <div class="auth-field">
          <label class="auth-label">CONFIRMAR NOVA SENHA</label>
          <%= f.input :password_confirmation, required: true, label: false, input_html: { class: 'auth-input' } %>
        </div>

        <div class="auth-actions">
          <%= f.button :submit, 'ALTERAR SENHA', class: 'auth-btn-success' %>
        </div>
      </div>
    <% end %>

    <div class="auth-footer-links">
      <%= render 'users/shared/links' %>
    </div>
  </div>
</div>