<% unless @armables.empty? %>
  <div class="terminal-card">
    <div class="terminal-card-header">
      <span>ARMORIAL // EQUIPAR OGIVAS & SISTEMAS</span>
    </div>

    <div class="armory-list">
      <% @armables.each do |armable| %>
        <%= simple_form_for armable, url: url_for(action: 'arm') do |f| %>
          <div class="armory-row">
            <span class="armory-unit-name" style="<%= style(armable) %>"><%= show(armable) %></span>
            <%= simple_fields_for :custom do |c| %>
              <%= c.hidden_field :id, value: armable.id %>
              <div class="armory-controls">
                <%= c.input :quantity, collection: (1..armable.quantity), selected: armable.quantity, label: false, input_html: { class: 't-select-xs' } %>
                <%= c.input :armament, collection: @armaments, selected: @armaments.first, label: false, input_html: { class: 't-select-sm' } %>
                <%= f.submit 'EQUIPAR', class: 't-btn-xs t-btn-success' %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>