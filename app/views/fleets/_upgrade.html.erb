<div class="terminal-card">
  <div class="terminal-card-header terminal-header-split">
    <span>ENGENHARIA & SENSORES DE LONGO ALCANCE</span>
    <span class="level-pill">NÍVEL <%= @fleet.level %> / 3</span>
  </div>

  <%= simple_form_for @fleet, url: url_for(action: 'upgrade') do |f| %>
    <%= simple_fields_for :custom do |c| %>
      <%= c.hidden_field :id, value: @fleet.id %>
    <% end %>
    <div class="upgrade-row">
      <div class="upgrade-info">
        <div>Aprimorar sistemas da nave capitânia (Nível 3 habilita <strong>Radar Setorial</strong>).</div>
        <div class="upgrade-cost">Investimento: <span><%= @setup.upgrade_cost %> créditos</span></div>
      </div>
      <%= f.submit 'UPGRADE', class: 't-btn t-btn-primary', onclick: "return confirm('Custo: #{@setup.upgrade_cost} créditos. Confirma o upgrade?')" %>
    </div>
  <% end %>
</div>