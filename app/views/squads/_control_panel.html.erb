<div class="hud-wrapper" style="--squad-color: <%= @squad.color.presence || '#38bdf8' %>;">
  <div class="hud-bar">
    
    <!-- BLOCO 1: IDENTIDADE DO COMANDANTE -->
    <div class="hud-section hud-identity">
      <div class="hud-logo">
        <%= image_tag('squads/star wars.png', class: 'hud-brand-img') %>
      </div>

      <div class="hud-squad-badge">
        <info class="tooltip">
          <tip>Configurar Esquadrão & Cor</tip>
          <a href="/squads/<%= @squad.id %>/edit" data-turbo="false" class="hud-emblem-btn" onclick="return openTacticalModal(event, this.href, 'SETUP // <%= j @squad.name.upcase %>', 440);">
            <%= image_tag(@squad.image, class: 'hud-squad-img') %>
            <span class="hud-edit-dot">⚙</span>
          </a>
        </info>
      </div>

      <div class="hud-squad-info">
        <div class="hud-squad-name"><%= @squad.name %></div>
        <div class="hud-faction-tag">
          <span class="hud-pulse-dot"></span>
          <%= @squad.faction.name.upcase %>
        </div>
      </div>
    </div>

    <div class="hud-divider"></div>

    <!-- BLOCO 2: TELEMETRIA DE TURNO E ECONOMIA -->
    <div class="hud-section hud-telemetry">
      <!-- Módulo de Turno -->
      <div class="hud-stat-box">
        <span class="hud-stat-label">CICLO / TURNO</span>
        <div class="hud-stat-value-row">
          <span class="hud-turn-number">#<%= @round.number.to_s.rjust(2, '0') %></span>
          <span class="hud-phase-badge <%= @round.strategy? ? 'phase-strategy' : 'phase-combat' %>">
            <%= @round.phase.upcase %>
          </span>
        </div>
      </div>

      <!-- Módulo de Créditos -->
      <div class="hud-stat-box hud-credits-box">
        <span class="hud-stat-label">TESOURO / CRÉDITOS</span>
        <div class="hud-stat-value-row">
          <!-- Ícone SVG Créditos Galácticos -->
          <svg class="hud-icon-sm hud-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 19 6 19 18 12 22 5 18 5 6 12 2"></polygon>
            <line x1="12" y1="6" x2="12" y2="18"></line>
            <path d="M9 9h6M9 15h6"></path>
          </svg>
          <span class="hud-credits-value"><%= number_with_delimiter(@squad_credits, delimiter: '.') %></span>
          <info class="tooltip">
            <tip>Receita líquida estimada no próximo turno</tip>
            <span class="hud-income-pill">+<%= number_with_delimiter(@squad_income, delimiter: '.') %>/turno</span>
          </info>
        </div>
      </div>
    </div>

    <div class="hud-divider"></div>

    <!-- BLOCO 3: CONSOLE DE COMANDO (ATALHOS) -->
    <div class="hud-section hud-actions">
      
      <!-- Catálogo de Unidades -->
      <info class="tooltip">
        <tip>Banco de Dados de Naves e Tropas</tip>
        <a href="/units/index" data-turbo="false" class="hud-btn" onclick="return openTacticalModal(event, this.href, 'BANCO DE DADOS // UNIDADES', 920);">
          <svg class="hud-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 2L4 20l8-4 8 4L12 2z"></path>
            <path d="M12 16v-6"></path>
          </svg>
          <span>UNIDADES</span>
        </a>
      </info>

      <!-- Relatórios de Combate -->
      <info class="tooltip">
        <tip>Logs Táticos e Relatórios de Batalha</tip>
        <a href="/results" data-turbo="false" class="hud-btn" onclick="return openTacticalModal(event, this.href, 'LOGS TÁTICOS // COMBATES', 750);">
          <svg class="hud-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="9"></circle>
            <circle cx="12" cy="12" r="3"></circle>
            <line x1="12" y1="2" x2="12" y2="5"></line>
            <line x1="12" y1="19" x2="12" y2="22"></line>
            <line x1="2" y1="12" x2="5" y2="12"></line>
            <line x1="19" y1="12" x2="22" y2="12"></line>
          </svg>
          <span>COMBATES</span>
        </a>
      </info>

      <!-- Crônicas / Narrativas HoloNet -->
      <info class="tooltip">
        <tip>Crônicas da Guerra Galáctica (HoloNet)</tip>
        <a href="/narratives" data-turbo="false" class="hud-btn" onclick="return openTacticalModal(event, this.href, 'TRANSMISSÕES // HOLONET', 900);">
          <svg class="hud-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            <line x1="8" y1="7" x2="16" y2="7"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <span>NARRATIVAS</span>
        </a>
      </info>

      <!-- Setup do Sistema -->
      <info class="tooltip">
        <tip>Parâmetros da Partida</tip>
        <a href="/setups" data-turbo="false" class="hud-btn" onclick="return openTacticalModal(event, this.href, 'PARÂMETROS // SETUP', 440);">
          <svg class="hud-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l-.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.6.85 1 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          <span>SETUP</span>
        </a>
      </info>

      <!-- Botão Principal: Finalizar Turno -->
      <info class="tooltip">
        <tip><%= @squad.ready? ? 'Ordens confirmadas. Aguardando outros esquadrões...' : 'Confirmar ordens e encerrar seu turno' %></tip>
        <%= button_to squads_ready_path,
                      method: :post,
                      form: { class: 'hud-inline-form', data: { turbo_confirm: 'Passar Turno. Tem certeza?' } },
                      class: "hud-btn-turn #{@squad.ready? ? 'is-ready' : ''}" do %>
          <svg class="hud-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <% if @squad.ready? %>
              <polyline points="20 6 9 17 4 12"></polyline>
            <% else %>
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            <% end %>
          </svg>
          <span><%= @squad.ready? ? 'AGUARDANDO' : 'FINALIZAR TURNO' %></span>
        <% end %>
      </info>

      <!-- Logoff -->
      <info class="tooltip">
        <tip>Desconectar da Ponte de Comando</tip>
        <%= button_to destroy_user_session_path,
                      method: :delete,
                      form: { class: 'hud-inline-form' },
                      class: 'hud-btn hud-btn-danger' do %>
          <svg class="hud-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>SAIR</span>
        <% end %>
      </info>

    </div>
  </div>

  <!-- BARRA DE STATUS TÁTICO INTEGRADA (SUBSTITUI O STATUS_PANEL FLUTUANTE) -->
  <% if @status.present? %>
    <div class="hud-ticker">
      <span class="hud-ticker-prefix">TRANSMISSÃO // </span>
      <span class="hud-ticker-text"><%= raw @status %></span>
    </div>
  <% end %>
</div>