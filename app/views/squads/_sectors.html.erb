<svg class="galaxy-grid" width="<%= (@map_x_adjust + 1700) * @map_ratio %>" height="<%= 1300 * @map_ratio %>">
  <defs>
    <filter id="glow-line" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Eixo Horizontal Galáctico -->
  <polyline points="
     <%= (@map_x_adjust + 10) * @map_ratio %>,<%= (@map_y_adjust + 650) * @map_ratio %>
     <%= (@map_x_adjust + 1700) * @map_ratio %>,<%= (@map_y_adjust + 650) * @map_ratio %>"
     stroke="rgba(56, 189, 248, 0.24)" stroke-width="1" stroke-dasharray="4,4" fill="none" />

  <!-- Eixo Diagonal Superior -->
  <polyline points="
     <%= (@map_x_adjust + 1010) * @map_ratio %>,<%= (@map_y_adjust + 10) * @map_ratio %>
     <%= (@map_x_adjust + 680) * @map_ratio %>,<%= (@map_y_adjust + 650) * @map_ratio %>"
     stroke="rgba(56, 189, 248, 0.24)" stroke-width="1" stroke-dasharray="4,4" fill="none" />

  <!-- Eixo Diagonal Inferior -->
  <polyline points="
     <%= (@map_x_adjust + 640) * @map_ratio %>,<%= (@map_y_adjust + 650) * @map_ratio %>
     <%= (@map_x_adjust + 960) * @map_ratio %>,<%= (@map_y_adjust + 1300) * @map_ratio %>"
     stroke="rgba(56, 189, 248, 0.24)" stroke-width="1" stroke-dasharray="4,4" fill="none" />

  <!-- Rótulos dos Quadrantes -->
  <text x="<%= (@map_x_adjust + 615) * @map_ratio %>" y="<%= (@map_y_adjust + 640) * @map_ratio %>" class="sector-label">ALPHA</text>
  <text x="<%= (@map_x_adjust + 695) * @map_ratio %>" y="<%= (@map_y_adjust + 640) * @map_ratio %>" class="sector-label">BETA</text>
  <text x="<%= (@map_x_adjust + 585) * @map_ratio %>" y="<%= (@map_y_adjust + 668) * @map_ratio %>" class="sector-label">DELTA</text>
  <text x="<%= (@map_x_adjust + 660) * @map_ratio %>" y="<%= (@map_y_adjust + 668) * @map_ratio %>" class="sector-label">GAMMA</text>
</svg>